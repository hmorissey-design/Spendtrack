# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google AdSense (Client-side variables must start with VITE_ to be exposed to Vite)
# VITE_ADSENSE_CLIENT_ID: Your Google AdSense Publisher ID (e.g., ca-pub-XXXXXXXXXXXXXXXX)
# VITE_ADSENSE_TOP_SLOT_ID: Your AdSense Ad Slot ID for the top ad unit (e.g., YYYYYYYYYY)
# VITE_ADSENSE_BOTTOM_SLOT_ID: Your AdSense Ad Slot ID for the bottom ad unit (e.g., ZZZZZZZZZZ)
# VITE_ADSENSE_CLIENT_ID=
# VITE_ADSENSE_TOP_SLOT_ID=
# VITE_ADSENSE_BOTTOM_SLOT_ID=

# Lemon Squeezy Checkout URLs
VITE_LEMON_SQUEEZY_TRIAL_URL=https://loosebudget.lemonsqueezy.com/checkout/buy/6a55af9b-b545-40bd-a55d-9e55022abc6b
VITE_LEMON_SQUEEZY_MONTHLY_URL=https://loosebudget.lemonsqueezy.com/checkout/buy/82e0d56b-82f8-42d5-88c4-44c547f540d6
VITE_LEMON_SQUEEZY_YEARLY_URL=https://loosebudget.lemonsqueezy.com/checkout/buy/0be2aa11-aecf-4a78-8d2c-9e66317ab504
VITE_LEMON_SQUEEZY_STORE_URL=https://loosebudget.lemonsqueezy.com/my-orders
