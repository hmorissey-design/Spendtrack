<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Left Column: Remaining Budget & Health Status -->
    <LinearLayout
        android:id="@+id/widget_budget_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Top Row: Remaining Label + Health Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REMAINING"
                android:textColor="#9CA3AF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/widget_bullet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#4B5563"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On Track"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Balance Amount -->
        <TextView
            android:id="@+id/widget_remaining_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$--.--"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Right Side: 1-Tap Microphone Voice Action Button -->
    <LinearLayout
        android:id="@+id/widget_voice_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_mic_button_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/widget_mic_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_mic"
            android:tint="#FFFFFF"
            android:contentDescription="Voice Add Expense" />

        <TextView
            android:id="@+id/widget_voice_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="5dp" />
    </LinearLayout>

</LinearLayout>
